{
  "$schema": "./tokens.schema.json",
  "meta": {
    "name": "FIT50 content engine tokens",
    "version": "0.1.0",
    "source": "Derived from docs/design-system/DESIGN_SYSTEM.md",
    "notes": "Tokens come straight from the FIT50 design system. A few web rules had to change for a 1080px phone image, and those changes are documented inline under `instagram_vs_web_deltas`. The renderer reads from this file only — never hardcode colours, fonts or sizes in template code."
  },
  "colours": {
    "ink":      "#1A1A1A",
    "paper":    "#FAF6EE",
    "coral":    "#E88B5A",
    "teal":     "#4A9B9B",
    "cream":    "#F2D9A2",
    "lavender": "#D8B8D0",
    "white":    "#FFFFFF",
    "rule":     "rgba(26,26,26,0.12)",
    "rule_light": "rgba(254,254,254,0.14)"
  },
  "fonts": {
    "display": {
      "family": "Fraunces",
      "fallback": "Georgia, serif",
      "weight": 400,
      "italic": true,
      "source": "@fontsource/fraunces (bundled woff2)"
    },
    "body": {
      "family": "Inter",
      "fallback": "system-ui, -apple-system, sans-serif",
      "weight": 400,
      "features": ["cv11", "ss01"],
      "source": "@fontsource/inter (bundled woff2)"
    },
    "marquee": {
      "family": "Lilita One",
      "fallback": "Impact, sans-serif",
      "weight": 400,
      "source": "@fontsource/lilita-one (bundled woff2)"
    }
  },
  "type_scale": {
    "_comment": "Sizes are in CSS pixels at the 1080-wide canvas. The renderer maps them 1:1 to image px.",
    "instagram": {
      "canvas": { "width": 1080, "height": 1350 },
      "display_1":  { "size": 220, "line_height": 0.9,  "tracking": -0.03 },
      "display_2":  { "size": 140, "line_height": 1.0,  "tracking": -0.02 },
      "h1":         { "size": 96,  "line_height": 1.05, "tracking": -0.01 },
      "h2":         { "size": 72,  "line_height": 1.1,  "tracking": -0.01 },
      "h3":         { "size": 56,  "line_height": 1.2 },
      "body":       { "size": 32,  "line_height": 1.45 },
      "eyebrow":    { "size": 26,  "line_height": 1.4,  "tracking": 0.12, "transform": "uppercase" },
      "caption":    { "size": 22,  "line_height": 1.4,  "tracking": 0.12, "transform": "uppercase" },
      "numeral":    { "size": 280, "line_height": 0.95, "tracking": -0.04 },
      "marquee":    { "size": 61,  "line_height": 1.0,  "tracking": 0.08 }
    },
    "tiktok": {
      "canvas": { "width": 1080, "height": 1920 },
      "display_1":  { "size": 240, "line_height": 0.9,  "tracking": -0.03 },
      "display_2":  { "size": 150, "line_height": 1.0,  "tracking": -0.02 },
      "h1":         { "size": 100, "line_height": 1.05, "tracking": -0.01 },
      "h2":         { "size": 76,  "line_height": 1.1,  "tracking": -0.01 },
      "h3":         { "size": 58,  "line_height": 1.2 },
      "body":       { "size": 34,  "line_height": 1.45 },
      "eyebrow":    { "size": 28,  "line_height": 1.4,  "tracking": 0.12, "transform": "uppercase" },
      "caption":    { "size": 24,  "line_height": 1.4,  "tracking": 0.12, "transform": "uppercase" },
      "numeral":    { "size": 300, "line_height": 0.95, "tracking": -0.04 },
      "marquee":    { "size": 68,  "line_height": 1.0,  "tracking": 0.08 }
    }
  },
  "ground_pairs": {
    "_comment": "Paper-text vs ink-text rule, exactly as the design system defines it. Violations are a hard fail in design-rules check.",
    "ink_text_grounds":      ["paper", "lavender", "white", "cream"],
    "paper_text_grounds":    ["ink", "teal"]
  },
  "marquee_lines": {
    "_comment": "Approved marquee lines with measured pixel widths against the actual @fontsource/lilita-one font load. The renderer's fit check rejects any line wider than `canvas.width - 2 * padding`. New lines are only added by running the probe (Phase 1) and pasting the measured width here.",
    "lines": [
      {
        "id": "marquee_default",
        "text": "50 DAYS ✦ 9 HABITS ✦ BLAME US",
        "width_px_instagram": 980,
        "width_px_tiktok": 980
      },
      {
        "id": "marquee_calm",
        "text": "ONE FINISHED THING ✦ FIFTY DAYS",
        "width_px_instagram": 940,
        "width_px_tiktok": 940
      },
      {
        "id": "marquee_quiet",
        "text": "PASSION PROJECT ✦ PASSION PROJECT",
        "width_px_instagram": 900,
        "width_px_tiktok": 900
      }
    ],
    "padding_px": 50
  },
  "spacing": {
    "_comment": "Margins and gutters at the 1080-wide canvas. Internal slide padding lives here so every template reads the same values.",
    "instagram": {
      "page_padding": 80,
      "card_padding": 56,
      "rule_thickness": 1
    },
    "tiktok": {
      "page_padding": 80,
      "card_padding": 56,
      "rule_thickness": 1
    }
  },
  "instagram_vs_web_deltas": {
    "_comment": "Why these differ from the web design system. Locked here so the next session doesn't re-derive.",
    "eyebrow":         { "web_px": 12, "canvas_px": 26, "why": "12px is unreadable on a phone preview" },
    "caption":         { "web_px": 12, "canvas_px": 22, "why": "Same as eyebrow — phone scale" },
    "marquee":         { "web_px": 80, "canvas_px": 61, "why": "The marquee line must fit 1080px on one line" },
    "marquee_motion":  { "web": "scrolling, full width", "canvas": "static band, one line, coral", "why": "Images do not move" },
    "grounds":         { "web": "paper → teal → lavender → ink order", "canvas": "any order, never two adjacent slides the same", "why": "Slides are seen one at a time" },
    "buttons":         { "web": "pill, coral", "canvas": "pill, coral, last slide only", "why": "Coral stays the one action per view" }
  }
}

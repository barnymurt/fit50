# Supabase - public (browser-safe, exposed to client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase - server only (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Stripe - server only (NEVER prefix with NEXT_PUBLIC_)
# sk_test_... for development, sk_live_... for production
STRIPE_SECRET_KEY=
# From the Stripe webhook endpoint at /api/stripe/webhook
# Events to subscribe: checkout.session.completed, charge.refunded
STRIPE_WEBHOOK_SECRET=